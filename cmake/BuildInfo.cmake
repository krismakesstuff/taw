# Run at every build (cmake -P): writes OUT, a source file saying which build this is: the commit,
# whether the tree had changes on top of it, and when. OUT is only rewritten when the source
# changed, so a build with nothing new doesn't relink.

execute_process(COMMAND git rev-parse --short HEAD WORKING_DIRECTORY "${SRC}"
                OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git diff HEAD WORKING_DIRECTORY "${SRC}"
                OUTPUT_VARIABLE diff ERROR_QUIET)

if (commit STREQUAL "")
    set(commit "unknown")
endif()

set(dirty "")
if (NOT diff STREQUAL "")
    set(dirty "+")
endif()

string(MD5 key "${commit}${diff}")

if (EXISTS "${OUT}")
    file(READ "${OUT}" old)
    string(FIND "${old}" "${key}" found)
    if (NOT found EQUAL -1)
        return()
    endif()
endif()

string(TIMESTAMP built "%b %d %H:%M")

file(WRITE "${OUT}" "// Generated by cmake/BuildInfo.cmake (source ${key}).
namespace taw
{
const char* buildCommit() { return \"${commit}${dirty}\"; }
const char* buildTime() { return \"${built}\"; }
}
")
